<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.RollCall" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/success_green</item>
        <item name="colorOnTertiary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorSurface">@color/background_secondary</item>
        <item name="colorSurfaceVariant">@color/background_tertiary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/on_primary</item>
        <item name="colorOutline">@color/glass_border</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#142329</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="bottomNavigationStyle">@style/Widget.RollCall.BottomNavigation</item>
        <item name="floatingActionButtonStyle">@style/Widget.RollCall.FAB</item>
        <item name="materialCardViewStyle">@style/Widget.RollCall.Card</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.RollCall.HeadlineMedium</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.RollCall.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.RollCall.TitleLarge</item>
    </style>

    <style name="Theme.RollCall" parent="Base.Theme.RollCall" />

    <style name="TextAppearance.RollCall.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RollCall.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RollCall.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RollCall.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/navigation_frosted_background</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.RollCall.BottomNavIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.RollCall.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_subtle</item>
    </style>

    <style name="Widget.RollCall.FAB" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.RollCall.Pill</item>
    </style>

    <style name="ShapeAppearance.RollCall.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.RollCall.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.RollCall.Card.Glass" parent="Widget.RollCall.Card">
        <item name="cardBackgroundColor">@color/glass_background</item>
        <item name="strokeColor">@color/glass_border</item>
    </style>
</resources>
